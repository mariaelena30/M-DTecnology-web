# BREVO API (CRM - Guardar contactos)
# 1. Ir a https://app.brevo.com/
# 2. Login con tu cuenta
# 3. Settings → SMTP & API → API Keys
# 4. Copiar la clave y pegar aquí
BREVO_API_KEY=tu_clave_brevo_aqui

# RESEND API (Email automático)
# 1. Ir a https://resend.com/
# 2. Sign up con tu email
# 3. API Keys → Copiar clave
RESEND_API_KEY=tu_clave_resend_aqui

# EMAIL DEL ADMIN (Dónde recibes notificaciones)
# Reemplaza con tu email
ADMIN_EMAIL=mdsolutionstecnology@gmail.com

# DOMINIO (Cuando tengas dominio personalizado)
NEXT_PUBLIC_DOMAIN=mdsolutions.tech

